              "dedicatedBackendConnection": false,
              "connectionDraining": {
                "enabled": false,
                "drainTimeoutInSec": 1
              },
              "validateCertChainAndExpiry": true,
              "validateSNI": true,
              "probe": {
                "id": "[resourceId('Microsoft.Network/applicationGateways/probes', parameters('applicationGatewayName'), 'capstone-backend-health')]"
              }
            }
          }
        ],
        "httpListeners": [
          {
            "name": "appGatewayHttpListener",
            "properties": {
