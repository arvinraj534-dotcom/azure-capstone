                }
              ]
            }
          }
        ],
        "probes": [
          {
            "name": "capstone-backend-health",
            "properties": {
              "protocol": "Https",
              "path": "/api/health",
              "interval": 30,
              "timeout": 30,
              "unhealthyThreshold": 3,
              "host": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2024-11-01').defaultHostName]",
              "pickHostNameFromBackendHttpSettings": false,
              "match": {
                "statusCodes": [
